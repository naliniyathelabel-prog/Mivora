{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalysisEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "source_asset_id",
    "image_assessment",
    "visibility_map",
    "observations",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "source_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "image_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_quality", "view", "crop", "distortion_factors"],
      "properties": {
        "overall_quality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "view": {
          "type": "string"
        },
        "crop": {
          "type": "string"
        },
        "distortion_factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "visibility_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region", "present", "visibility", "reliability"],
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "present": {
            "type": "boolean"
          },
          "visibility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "status", "literal_observation"],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "soul_id": {
            "type": "string"
          },
          "source_asset_id": {
            "type": "string"
          },
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "partially_observed",
              "unknown",
              "unreliable",
              "conflicting",
              "not_applicable"
            ]
          },
          "literal_observation": {
            "type": "string",
            "minLength": 1
          },
          "normalized_value": {
            "type": "object",
            "additionalProperties": true
          },
          "source_region": {
            "type": "object",
            "additionalProperties": true
          },
          "visibility": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reliability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observation_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "unknown_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          },
          "distortion_factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_group_id": {
            "type": "string"
          },
          "extractor": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["observed", "partially_observed"]
                }
              }
            },
            "then": {
              "required": ["source_region"]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "required": ["unknown_reasons"],
              "properties": {
                "unknown_reasons": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
